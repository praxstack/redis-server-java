{
  "name": "Redis Server Java",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "./scripts/cloud-agent-install.sh",
  "start": "echo redis-server-java-cloud-agent-start",
  "terminals": [
    {
      "name": "Redis Server",
      "command": "java -jar target/redis-server-java-1.0.0.jar",
      "description": "RESP2-compatible Redis server on port 6379"
    }
  ],
  "ports": [
    {
      "name": "redis",
      "port": 6379
    }
  ]
}
